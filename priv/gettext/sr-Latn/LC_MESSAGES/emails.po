#: lib/hospitality_coms/accounts/person_notifier.ex:37
#, elixir-autogen, elixir-format
msgid "\n==============================\n\nHi %{email},\n\nYou can change your email by visiting the URL below:\n\n%{url}\n\nIf you didn't request this change, please ignore this.\n\n==============================\n"
msgstr "\n==============================\n\nZdravo %{email},\n\nSvoju imejl adresu možete promeniti na sledećoj adresi:\n\n%{url}\n\nAko niste tražili ovu promenu, slobodno zanemarite ovu poruku.\n\n==============================\n"

#: lib/hospitality_coms/accounts/person_notifier.ex:103
#, elixir-autogen, elixir-format
msgid "\n==============================\n\nHi %{email},\n\nYou can confirm your account by visiting the URL below:\n\n%{url}\n\nIf you didn't create an account with us, please ignore this.\n\n==============================\n"
msgstr "\n==============================\n\nZdravo %{email},\n\nSvoj nalog možete potvrditi na sledećoj adresi:\n\n%{url}\n\nAko niste otvorili nalog kod nas, slobodno zanemarite ovu poruku.\n\n==============================\n"

#: lib/hospitality_coms/accounts/person_notifier.ex:76
#, elixir-autogen, elixir-format
msgid "\n==============================\n\nHi %{email},\n\nYou can log into your account by visiting the URL below:\n\n%{url}\n\nIf you didn't request this email, please ignore this.\n\n==============================\n"
msgstr "\n==============================\n\nZdravo %{email},\n\nNa svoj nalog možete se prijaviti na sledećoj adresi:\n\n%{url}\n\nAko niste tražili ovu poruku, slobodno je zanemarite.\n\n==============================\n"

