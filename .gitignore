/_build
/cover
/deps
/doc
/.fetch
erl_crash.dump
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
hospitality_coms-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Dialyzer PLT cache.
/priv/plts/

# Agent worktrees, created by parallel subagent dispatch.
.claude/worktrees/

# npm run from the repo root instead of client/ leaves one of these behind.
# There is no package.json here; the only one is client/package.json.
/package-lock.json
