/_build
/cover
/deps
/doc
/.fetch
erl_crash.dump
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
hospitality_coms-*.tar

# The built client, one directory per locale. `client/vite.config.ts` writes
# `dist/<locale>/` and the deployment copies it here; `HospitalityComsWeb.Static`
# serves whichever one the request's host names. Nothing under here is source,
# and `static_test.exs` writes fixtures into it and removes them again.
/priv/static/

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Dialyzer PLT cache.
/priv/plts/

# Agent worktrees, created by parallel subagent dispatch.
.claude/worktrees/

# npm run from the repo root instead of client/ leaves one of these behind.
# There is no package.json here; the only one is client/package.json.
/package-lock.json
